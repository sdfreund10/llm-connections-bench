---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeContent from "../components/HomeContent.astro";
import { getPaginatedDates, getHomePageCount, getModelStats } from "../lib/data";

const currentPage = 1;
const totalPages = getHomePageCount();
const dates = getPaginatedDates(currentPage);
const stats = getModelStats();
---

<BaseLayout
  title="llm-connections — LLMs vs Connections"
  description="How well do language models play Connections? Daily results and season standings."
  showNav
>
  <HomeContent {dates} {stats} {currentPage} {totalPages} />
</BaseLayout>
