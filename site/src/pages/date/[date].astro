---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ModelRuns from "../../components/ModelRuns.astro";
import PuzzleCategories from "../../components/PuzzleCategories.astro";
import { getDateSummary, formatDate, getDatesWithRuns } from "../../lib/data";

export function getStaticPaths() {
  return getDatesWithRuns().map((date) => ({ params: { date } }));
}

const { date } = Astro.params;
const summary = date ? getDateSummary(date) : null;

if (!summary) {
  return Astro.redirect("/");
}
---

<BaseLayout
  title={`Connections ${formatDate(date!)} — model results | llm-connections`}
  description={`Model results for the Connections puzzle on ${date}.`}
  showNav
>
  <a class="date-page__back" href="/">← All dates</a>
  <h1 class="date-page__title">{formatDate(date!)}</h1>
  <p
    class="date-page__subtitle"
    data-model-visible-count
    data-model-total={summary.runs.length}
  >
    {summary.runs.length} model{summary.runs.length === 1 ? "" : "s"} played this puzzle
  </p>

  {summary.puzzle && <PuzzleCategories puzzle={summary.puzzle} />}

  <ModelRuns summary={summary} />
</BaseLayout>
