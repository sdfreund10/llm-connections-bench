---
import "../styles/global.css";
import ModelFilter from "../components/ModelFilter.astro";
import { DEFAULT_MODELS, MODEL_QUERY_PARAM } from "../lib/models";
import {
  absoluteUrl,
  authorName,
  defaultDescription,
  defaultTitle,
  githubUrl,
  openRouterUrl,
  personalSiteUrl,
  puzzleSourceUrl,
  siteUrl,
} from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  showNav?: boolean;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = defaultTitle,
  description = defaultDescription,
  showNav = false,
  ogType = "website",
  jsonLd,
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname);

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "llm-connections",
  url: siteUrl,
  description: defaultDescription,
  author: {
    "@type": "Person",
    name: authorName,
  },
};

const jsonLdBlocks = jsonLd
  ? Array.isArray(jsonLd)
    ? [websiteJsonLd, ...jsonLd]
    : [websiteJsonLd, jsonLd]
  : [websiteJsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="llm-connections" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico?v=4" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=4" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700;800&family=Caprasimo&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    {
      jsonLdBlocks.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header__inner">
        <div class="site-header__brand">
          <a class="site-logo" href="/">
            <span class="site-logo__mark" aria-hidden="true">4</span>
            <span class="site-logo__text">llm-connections</span>
          </a>
          <p class="site-tagline">Language models vs. the daily word puzzle</p>
        </div>
        {
          showNav && (
            <nav class="site-nav" aria-label="Primary">
              <a class="site-nav__link" href="/">Results</a>
              <a class="site-nav__link" href="/#standings">Standings</a>
              <a class="site-nav__link" href="/about/">About</a>
            </nav>
          )
        }
      </div>
    </header>
    <ModelFilter />
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Unofficial benchmark by {authorName} — not affiliated with The New York Times or
        Connections. Models via{" "}
        <a href={openRouterUrl} rel="noopener noreferrer">OpenRouter</a>. Puzzle data from{" "}
        <a href={puzzleSourceUrl} rel="noopener noreferrer">Eyefyre/NYT-Connections-Answers</a>.
      </p>
      <p class="site-footer__links">
        <a href="/about/">About</a>
        <span aria-hidden="true">·</span>
        <a href={githubUrl} rel="noopener noreferrer">Source</a>
        {
          personalSiteUrl && (
            <>
              <span aria-hidden="true">·</span>
              <a href={personalSiteUrl} rel="noopener noreferrer">Personal site</a>
            </>
          )
        }
      </p>
    </footer>
    <script is:inline define:vars={{ defaults: [...DEFAULT_MODELS], param: MODEL_QUERY_PARAM }}>
      (function () {
        var params = new URLSearchParams(window.location.search);
        var selected;
        if (!params.has(param)) {
          selected = defaults.slice();
        } else {
          var raw = params.get(param) || "";
          selected = raw
            ? raw.split(",").map(function (s) {
                try {
                  return decodeURIComponent(s.trim());
                } catch (e) {
                  return s.trim();
                }
              }).filter(Boolean)
            : [];
        }
        var set = {};
        for (var i = 0; i < selected.length; i++) set[selected[i]] = true;

        var nodes = document.querySelectorAll("[data-model]");
        for (var j = 0; j < nodes.length; j++) {
          var el = nodes[j];
          if (set[el.getAttribute("data-model")]) el.setAttribute("data-show", "");
          else el.removeAttribute("data-show");
        }

        var toggles = document.querySelectorAll("[data-model-toggle]");
        for (var k = 0; k < toggles.length; k++) {
          toggles[k].checked = !!set[toggles[k].value];
        }

        var groups = document.querySelectorAll("[data-model-group]");
        for (var g = 0; g < groups.length; g++) {
          var group = groups[g];
          var any = group.querySelector("[data-model][data-show]");
          var empty = group.querySelector("[data-model-group-empty]");
          if (empty) empty.hidden = !!any;
        }

        var hint = document.querySelector("[data-model-filter-hint]");
        if (hint) hint.hidden = selected.length > 0;

        var summary = document.querySelector("[data-model-filter-summary]");
        if (summary) {
          summary.textContent =
            selected.length === 0 ? "None selected" : selected.length + " selected";
        }

        document.documentElement.classList.add("js");
      })();
    </script>
  </body>
</html>
