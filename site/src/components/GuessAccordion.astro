---
import type { Guess } from "../lib/types";
import { CATEGORY_COLORS, groupColorIndex } from "../lib/colors";
import { formatLatency, formatCost, formatTokens } from "../lib/data";

interface Props {
  guesses: Guess[];
  guessIndex: number;
  groupIndex?: number;
}

const { guesses, guessIndex, groupIndex } = Astro.props;
const guess = guesses[guessIndex];
const color =
  guess.success && groupIndex != null
    ? CATEGORY_COLORS[groupColorIndex(groupIndex)]
    : null;
const id = `guess-${guessIndex}`;
const tokens =
  guess.input_tokens != null || guess.output_tokens != null
    ? (guess.input_tokens ?? 0) + (guess.output_tokens ?? 0)
    : null;
const hasUsage =
  typeof guess.latency === "number" ||
  tokens != null ||
  typeof guess.total_cost === "number";
---

<details class="guess-accordion">
  <summary class="guess-accordion__summary">
    <span class="guess-accordion__num">Guess {guessIndex + 1}</span>
    <span class="guess-accordion__words">{guess.guess.join(" · ")}</span>
    {
      guess.success ? (
        <span class="guess-accordion__result guess-accordion__result--ok">Correct</span>
      ) : guess.invalid ? (
        <span class="guess-accordion__result guess-accordion__result--invalid">Invalid</span>
      ) : (
        <span class="guess-accordion__result guess-accordion__result--miss">Wrong</span>
      )
    }
    {
      typeof guess.latency === "number" && (
        <span class="guess-accordion__meta">{formatLatency(guess.latency)}</span>
      )
    }
  </summary>
  <div
    class:list={["guess-accordion__body", color && "guess-accordion__body--categorized"]}
    id={id}
    style={color ? `--category-color: ${color.bg}` : undefined}
  >
    <p class="guess-accordion__reasoning">{guess.reasoning}</p>
    {
      guess.invalid && guess.invalid_reason && (
        <p class="guess-accordion__invalid-reason">{guess.invalid_reason}</p>
      )
    }
    {
      hasUsage && (
        <dl class="guess-accordion__usage">
          {typeof guess.latency === "number" && (
            <>
              <dt>Latency</dt>
              <dd>{formatLatency(guess.latency)}</dd>
            </>
          )}
          {tokens != null && (
            <>
              <dt>Tokens</dt>
              <dd>
                {formatTokens(tokens)}
                {guess.input_tokens != null && guess.output_tokens != null && (
                  <span class="guess-accordion__usage-detail">
                    ({formatTokens(guess.input_tokens)} in / {formatTokens(guess.output_tokens)} out)
                  </span>
                )}
              </dd>
            </>
          )}
          {typeof guess.total_cost === "number" && (
            <>
              <dt>Cost</dt>
              <dd>{formatCost(guess.total_cost)}</dd>
            </>
          )}
        </dl>
      )
    }
  </div>
</details>
